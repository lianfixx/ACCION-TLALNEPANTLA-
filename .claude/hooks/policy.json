{
  "_doc": "Política de frenos (PreToolUse) para Claude Code. Ver guard.py para los tipos de regla. 'tests' son casos que comprueba test_guard.py.",
  "rules": [
    {
      "type": "pattern",
      "tool": "Bash",
      "field": "command",
      "input": "\\b(wrangler\\s+(deploy|publish|pages\\s+deploy|versions\\s+deploy)|vercel(\\s+(--prod|deploy))?(\\s|$)|netlify\\s+deploy|firebase\\s+deploy|npm\\s+publish|gh-pages|npm\\s+run\\s+(deploy|publish))\\b",
      "decision": "ask",
      "reason": "Vas a desplegar o publicar. Confirma la autorización concreta y comprueba después el estado publicado."
    },
    {
      "type": "pattern",
      "tool": "mcp__.*__.*(send|reply|forward|post_message|publish).*",
      "decision": "ask",
      "reason": "Vas a enviar o publicar algo a través de un conector. Confirma destinatario, propósito y adjuntos."
    },
    {
      "type": "pattern",
      "tool": "Bash",
      "field": "command",
      "input": "git\\s+(-C\\s+\\S+\\s+)?push\\b[^\\n;&|]*(\\s--force\\b|\\s--force-with-lease\\b|\\s-f\\b|\\s\\+\\S)",
      "decision": "deny",
      "reason": "No se permite `git push --force`: puede borrar historial ajeno."
    },
    {
      "type": "pattern",
      "tool": "Bash",
      "field": "command",
      "input": "(^|[;&|(]\\s*|\\s)git\\s+(-[Cc]\\s+\\S+\\s+)*push\\b",
      "decision": "ask",
      "reason": "Vas a publicar en GitHub. Confirma que la tarea actual autoriza este push."
    },
    {
      "type": "secrets",
      "git": "commit",
      "pii": true,
      "reason": "El cambio contiene posibles secretos o datos personales."
    },
    {
      "type": "before_git",
      "git": "commit",
      "staged_regex": "(^|/)SKILL\\.md$",
      "run": "python3 .claude/hooks/check_skill.py .agents/skills/accion-tlalnepantla",
      "reason": "El SKILL.md dejaría de ser compatible con claude.ai."
    },
    {
      "type": "before_git",
      "git": "commit",
      "staged_regex": "^\\.claude/hooks/",
      "run": "python3 .claude/hooks/test_guard.py",
      "reason": "Las pruebas de los frenos fallaron."
    }
  ],
  "tests": [
    {
      "name": "push forzado",
      "tool": "Bash",
      "input": {
        "command": "git push --force origin main"
      },
      "expect": "deny"
    },
    {
      "name": "comando inocuo",
      "tool": "Bash",
      "input": {
        "command": "ls -la"
      },
      "expect": "none"
    },
    {
      "name": "deploy pide confirmación",
      "tool": "Bash",
      "input": {
        "command": "npx wrangler deploy"
      },
      "expect": "ask"
    },
    {
      "name": "build permitido",
      "tool": "Bash",
      "input": {
        "command": "npm run build"
      },
      "expect": "none"
    }
  ]
}
